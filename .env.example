# ============================================================
#  VietNomNom — Frontend (Next.js)  |  .env.example
#  Copy to `.env.local` for local dev. NEVER commit `.env.local`.
#  NOTE: every NEXT_PUBLIC_* value is embedded in the browser
#  bundle — put NO secrets here.
# ============================================================

# --- Backend (NestJS) base URL, no trailing slash ---
# Local:      http://localhost:3001
# Production: https://<your-service>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Public site URL, used for SEO metadata / canonical links ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
